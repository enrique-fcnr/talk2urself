# Copie para .env na raiz. Preencha apenas no seu computador.
# Chaves são usadas pelo servidor; nunca adicione o prefixo VITE_.
OPENAI_API_KEY=
CARTESIA_API_KEY=
# Identificador de uma voz do catálogo (usada até existir a sua voz clonada).
CARTESIA_VOICE_ID=
# 1 pausa a voz da Cartesia: as respostas são geradas, mas faladas em silêncio (sem custo de voz).
CARTESIA_PAUSED=0
# 1 liga a clonagem automática da sua voz (exige plano Cartesia com clonagem, CARTESIA_PAUSED=0 e Supabase).
# Veja docs/clonagem-de-voz.md.
VOICE_CLONING=0
# Troque para gpt-6.1-sol quando comparar os modelos. Reinicie o servidor.
OPENAI_MODEL=gpt-6-luna

# Memória pessoal: secret key SOMENTE no servidor. Deixe vazia até configurar o banco.
SUPABASE_URL=https://obobqbbgvezophailcdk.supabase.co
SUPABASE_SECRET_KEY=
# Gere uma vez e preserve esse UUID. Todas as abas locais usam esse mesmo perfil.
LOCAL_USER_ID=
