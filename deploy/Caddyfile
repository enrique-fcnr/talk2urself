# Caddy in front of the app: HTTPS certificates (Let's Encrypt) are obtained and renewed automatically.
# setup.sh writes this file to /etc/caddy/Caddyfile with SITE_ADDRESS replaced by the domain.
SITE_ADDRESS {
	encode zstd gzip
	header Strict-Transport-Security "max-age=31536000"
	# The app listens only on this machine; WebSockets pass through as they are.
	reverse_proxy 127.0.0.1:3001
}
